# OPENAI_API_KEY: Required for OpenAI API calls.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# OPENAI_BASE_URL: Custom API endpoint URL (e.g. your custom proxy)
OPENAI_BASE_URL=

# OPENAI_MODEL: Custom model name (e.g. Llama-3.3-70b)
OPENAI_MODEL=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ONEDRIVE_TEMPLATES_LINK: Shared OneDrive folder URL containing INI templates.
# The AI agent uses this URL to locate and load partner INI templates.
ONEDRIVE_TEMPLATES_LINK="https://1drv.ms/f/s!ExampleSharedFolderLink"

